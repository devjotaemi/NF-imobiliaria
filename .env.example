# ---------------------------------------------------------------------------
# NF Negócios — variáveis de ambiente
# Copie para .env e preencha. Nunca commite o .env.
# ---------------------------------------------------------------------------

# Postgres (Neon, Vercel Postgres, ou local)
DATABASE_URL="postgresql://usuario:senha@host:5432/nadabe?schema=public"

# Segredo pra assinar o cookie de sessão do painel.
# Gere um novo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# WhatsApp da NF Negócios — só dígitos, com DDI e DDD. Ex.: 5511999998888
WHATSAPP_NUMERO=""

# Perfil da NF Negócios na OLX (link do rodapé).
# Se ficar vazio, o link simplesmente não é renderizado.
NEXT_PUBLIC_OLX_PERFIL_URL=""

# URL pública do site (usada em metadata/OG e no feed VRSync)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Upload de fotos (Vercel Blob). Em produção a Vercel injeta automaticamente.
# O painel aceita fotos de até 4 MB cada.
BLOB_READ_WRITE_TOKEN=""

# Contato que aparece DENTRO do XML do feed (cabeçalho + contato do anunciante
# em cada anúncio). Não é o CTA do site.
# Se FEED_TELEFONE ficar vazio, usa o WHATSAPP_NUMERO.
FEED_NOME="NF Negócios"
FEED_EMAIL=""
FEED_TELEFONE=""

# Perfil da NF no Diário Imóveis, usado por `npm run importar:diario`.
# Só precisa preencher se o portal renomear o perfil — o script já traz o atual
# como padrão. É o trecho final de diarioimoveis.com.br/imobiliarias/<slug>.
DIARIO_IMOVEIS_SLUG=""
